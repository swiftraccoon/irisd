+            assert!(poll_once(&mut connection, |c, cx| c.poll_flush(cx)).is_pending());
+            assert!(poll_once(&mut connection, |c, cx| c.poll_ready(cx)).is_pending());
+            assert!(
+                started.elapsed() < Duration::from_millis(100),
+                "a flush to a stalled peer took {:?}",
