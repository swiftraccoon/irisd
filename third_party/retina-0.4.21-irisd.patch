+    /// Sets `SO_RCVLOWAT` on the RTSP socket: `poll`/`epoll` then report the
+    /// socket readable only once at least `bytes` are queued, so a receiver
+    /// of a steady RTP flow wakes once per `bytes` instead of once per
+    /// packet. Only meaningful once data flows continuously (after `PLAY`);
+    /// set earlier, small RTSP responses would never trigger readiness.
+    pub(crate) fn set_recv_low_water(&self, bytes: u32) -> std::io::Result<()> {
+        let value = libc::c_int::try_from(bytes).map_err(|_| std::io::Error::other("value too large"))?;
+        // SAFETY: `fd` is a valid, open socket owned by `self.stream` for the
+        // duration of the call, and `value` outlives the call.
+        let rc = unsafe {
+            libc::setsockopt(
+                self.stream.as_raw_fd(),
+                libc::SOL_SOCKET,
+                libc::SO_RCVLOWAT,
+                std::ptr::from_ref(&value).cast::<libc::c_void>(),
+                std::mem::size_of::<libc::c_int>() as libc::socklen_t,
+            )
+        };
+        if rc == 0 {
+            Ok(())
+        } else {
+            Err(std::io::Error::last_os_error())
+        }
+    }
+
+    /// Takes the socket out of tokio's reactor. From then on reads that would
+    /// block return `Pending` without a waker and never wake `epoll`; the
+    /// caller polls the connection on its own timer. Writes block briefly.
+    /// Idempotent.
+    pub(crate) fn detach_from_reactor(&mut self) -> std::io::Result<()> {
+        if let Io::Reactor(_) = self.stream {
+            let Io::Reactor(reactor) = std::mem::replace(&mut self.stream, Io::Detaching) else {
+                unreachable!("checked above");
+            };
+            // `into_std` deregisters the descriptor from the reactor.
+            match reactor.into_std() {
+                Ok(std_stream) => {
+                    std_stream.set_nonblocking(true)?;
+                    self.stream = Io::Detached(std_stream);
+                }
+                Err(e) => return Err(e),
+            }
+        }
+        Ok(())
+    }
